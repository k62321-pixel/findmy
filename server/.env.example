GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SESSION_SECRET=replace-with-a-long-random-string
# Comma-separate multiple origins, e.g. https://found-it.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
PORT=4000

# Production-only settings (leave unset for local dev):
# FLASK_ENV=production
# SESSION_COOKIE_SAMESITE=None   # required once the frontend is on a different domain
