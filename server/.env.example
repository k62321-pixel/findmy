GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# 32+ random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-string
# Comma-separate multiple origins, e.g. https://found-it.netlify.app,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
PORT=4000

# Lost & found staff who can confirm returns, undo them and delete posts (comma-separated).
ADMIN_EMAILS=
# Only these Google account domains may sign in, e.g. school.ac.kr (comma-separated).
# Empty = any Google account. Admin emails are always allowed.
ALLOWED_EMAIL_DOMAINS=

# PostgreSQL connection string (items + photos). Required in production — free hosts
# wipe their disk on restart. e.g. Neon: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Leave empty for local dev: a SQLite file (items.db) is used instead.
# DATABASE_URL=
# Local SQLite location, defaults to this folder.
# DATA_DIR=

# Local only: FLASK_DEBUG=1 enables the Werkzeug debugger (never expose it on a network).
# FLASK_DEBUG=1

# Production-only settings (leave unset for local dev):
# FLASK_ENV=production
# SESSION_COOKIE_SAMESITE=None   # only if the frontend calls the API cross-domain (no Netlify proxy)
